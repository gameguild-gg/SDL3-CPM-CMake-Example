# SDL3_image
string(TIMESTAMP BEFORE "%s")
CPMAddPackage(GITHUB_REPOSITORY libsdl-org/SDL_image
        GIT_TAG release-3.4.6
        OPTIONS
        "SDLIMAGE_INSTALL OFF"
        "SDLIMAGE_SAMPLES OFF"
        "SDLIMAGE_VENDORED ON"
        "SDLIMAGE_DEPS_SHARED OFF"
        "SDLIMAGE_AVIF OFF"
        "BUILD_SHARED_LIBS OFF"
        "GIT_SUBMODULES_RECURSE ON"
)
string(TIMESTAMP AFTER "%s")
math(EXPR DELTASDL_image "${AFTER} - ${BEFORE}")
MESSAGE(STATUS "SDL3_image TIME: ${DELTASDL_image}s")

